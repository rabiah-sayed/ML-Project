SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Set to True + fill DB_* to use Postgres (docker-compose.yml matches these defaults).
USE_POSTGRES=False
DB_NAME=pricesense
DB_USER=pricesense
DB_PASSWORD=pricesense
DB_HOST=localhost
DB_PORT=5432

# Needed only for Celery (start Redis via docker-compose.yml).
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
